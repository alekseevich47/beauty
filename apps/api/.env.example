# Local API development — copy to apps/api/.env
# Dev-only values. Never reuse any of these in a deployed environment.
API_CONTOUR=dev
NODE_ENV=development
LOG_LEVEL=debug
API_PORT=3000
TRUSTED_PROXY_HOPS=0

DATABASE_URL=postgresql://beauty:beauty@localhost:5432/beauty
REDIS_CACHE_URL=redis://localhost:6379/0
REDIS_QUEUE_URL=redis://localhost:6380/0

# Ed25519 keypair for mini-app access tokens:
#   openssl genpkey -algorithm ed25519 -out jwt.pem
#   openssl pkey -in jwt.pem -pubout -out jwt.pub
# Paste with literal \n between lines.
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=

TELEGRAM_BOT_TOKEN=
MAX_PLATFORM_ENABLED=false

STAFF_JWT_SECRET=dev-staff-jwt-secret-min-32-chars!!!
# openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=

CORS_MINIAPP_ORIGINS=http://localhost:5173
CORS_ADMIN_ORIGINS=http://localhost:5174
PUBLIC_MINIAPP_URL=http://localhost:5173
PUBLIC_ADMIN_URL=http://localhost:5174
PUBLIC_API_URL=http://localhost:3000/api/v1
INTERNAL_API_URL=http://localhost:3000/api/v1

STAFF_COOKIE_SECURE=false
STAFF_COOKIE_DOMAIN=localhost

# Allows the widget to run without a per-master allowlist in local dev
WIDGET_REQUIRE_ORIGIN=false
WIDGET_DEFAULT_ALLOWED_ORIGINS=http://localhost:5175

PAYMENTS_ENABLED=false
AI_PROVIDER=noop

CENTRIFUGO_API_URL=http://localhost:8000/api
CENTRIFUGO_API_KEY=dev-api-key-change-me
CENTRIFUGO_TOKEN_SECRET=dev-token-secret-change-me

METRICS_TOKEN=dev-metrics-token-1234567890
