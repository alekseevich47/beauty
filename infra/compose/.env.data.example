# Data VM (10.8.0.2) — copy to .env.data on the host
COMPOSE_PROJECT_NAME=beauty-data

# POSTGRES_USER is the migration superuser; runtime services connect as
# beauty_api_miniapp / beauty_api_internal / beauty_worker instead.
POSTGRES_DB=beauty
POSTGRES_USER=beauty_admin
POSTGRES_PASSWORD=change-me-strong-db-password

# S3-compatible backup target (Yandex Object Storage / VK Cloud / MinIO)
S3_ENDPOINT=https://storage.yandexcloud.net
S3_BACKUP_BUCKET=beauty-backups
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=ru-central1
WALG_S3_PREFIX=s3://beauty-backups/wal-g
BACKUP_RETENTION_DAYS=14
