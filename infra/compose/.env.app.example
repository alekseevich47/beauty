# App VM (10.8.0.1) — copy to .env.app on the host and fill every blank.
# Variable names must match packages/config/src/index.ts; the API validates them
# with Zod at boot and refuses to start if anything is missing.
COMPOSE_PROJECT_NAME=beauty-app

REGISTRY=ghcr.io
IMAGE_NAMESPACE=loomixx/beauty
IMAGE_TAG=latest

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info
API_PORT=3000
API_HOST=0.0.0.0
# Number of reverse proxies in front of the API (Traefik = 1). Rate limiting
# derives the client IP from this; do not raise it without adding real proxies.
TRUSTED_PROXY_HOPS=1

# --- Data (data VM over WireGuard) ---
DATABASE_URL=postgresql://beauty_api_miniapp:change-me@10.8.0.2:5432/beauty
DATABASE_SSL=false
DATABASE_POOL_MAX=20
REDIS_CACHE_URL=redis://10.8.0.2:6379/0
REDIS_QUEUE_URL=redis://10.8.0.2:6380/0

# --- Mini-app auth (Ed25519 PEM, generate with:
#     openssl genpkey -algorithm ed25519 -out jwt.pem
#     openssl pkey -in jwt.pem -pubout -out jwt.pub
#     then inline with \n escapes or mount as files) ---
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=
JWT_ACCESS_TTL_SEC=900
JWT_REFRESH_TTL_SEC=2592000
INITDATA_MAX_AGE_SEC=86400
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_PLATFORM_ENABLED=false

# --- Staff secrets (still validated on this contour; keep distinct from admin VM) ---
STAFF_JWT_SECRET=
# openssl rand -base64 32
TOTP_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=

# --- Public URLs / CORS ---
PUBLIC_MINIAPP_URL=https://beauty.loomixx.ru
PUBLIC_ADMIN_URL=https://beautyadm.loomixx.ru
PUBLIC_API_URL=https://beauty.loomixx.ru/api/v1
INTERNAL_API_URL=https://beautyadm.loomixx.ru/api/v1
CORS_MINIAPP_ORIGINS=https://beauty.loomixx.ru
CORS_ADMIN_ORIGINS=https://beautyadm.loomixx.ru

# --- Widget ---
# Comma-separated fallback origins allowed to embed widgets that have none set.
WIDGET_DEFAULT_ALLOWED_ORIGINS=
# Keep true: with no allowlist configured the widget refuses to serve.
WIDGET_REQUIRE_ORIGIN=true

# --- Payments (YooKassa). Webhooks are rejected unless the secret is set. ---
PAYMENTS_ENABLED=false
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
YOOKASSA_WEBHOOK_SECRET=

# --- Storage ---
S3_ENDPOINT=https://storage.yandexcloud.net
S3_REGION=ru-central1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# --- AI ---
AI_PROVIDER=noop
YANDEX_GPT_API_KEY=
YANDEX_GPT_FOLDER_ID=
GIGACHAT_CREDENTIALS=

# --- Centrifugo ---
# API-side names
CENTRIFUGO_API_URL=http://centrifugo:8000/api
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_SECRET=
# Centrifugo container's own env names (must mirror the two values above)
CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=
CENTRIFUGO_ADMIN_PASSWORD=
CENTRIFUGO_ADMIN_SECRET=

# --- Observability ---
SENTRY_DSN_API=
SENTRY_DSN_WORKER=
OTEL_EXPORTER_OTLP_ENDPOINT=http://10.8.0.3:4318
# Bearer token required to scrape /metrics (min 16 chars)
METRICS_TOKEN=

# --- TLS ---
ACME_EMAIL=
CF_DNS_API_TOKEN=
