# Admin VM (10.8.0.3) — copy to .env.admin on the host and fill every blank.
# Variable names must match packages/config/src/index.ts.
COMPOSE_PROJECT_NAME=beauty-admin

REGISTRY=ghcr.io
IMAGE_NAMESPACE=loomixx/beauty
IMAGE_TAG=latest

# --- Runtime ---
NODE_ENV=production
LOG_LEVEL=info
# Staff API listens here and Traefik forwards beautyadm.loomixx.ru/api to it
API_PORT=3001
API_HOST=0.0.0.0
TRUSTED_PROXY_HOPS=1

# --- Data (data VM over WireGuard) ---
DATABASE_URL=postgresql://beauty_api_internal:change-me@10.8.0.2:5432/beauty
DATABASE_SSL=false
DATABASE_POOL_MAX=10
REDIS_CACHE_URL=redis://10.8.0.2:6379/1
REDIS_QUEUE_URL=redis://10.8.0.2:6380/0

# --- Staff auth ---
STAFF_JWT_SECRET=
STAFF_SESSION_TTL_SEC=28800
STAFF_COOKIE_NAME=beauty_staff_session
STAFF_COOKIE_SECURE=true
STAFF_COOKIE_DOMAIN=beautyadm.loomixx.ru
STAFF_TOTP_MAX_ATTEMPTS=5
STAFF_LOCKOUT_SEC=900
# openssl rand -base64 32 — must match the value used to enroll existing secrets
TOTP_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=

# --- Mini-app keys are still schema-required; use the same values as the app VM ---
JWT_ACCESS_PRIVATE_KEY=
JWT_ACCESS_PUBLIC_KEY=

# --- Public URLs / CORS ---
PUBLIC_MINIAPP_URL=https://beauty.loomixx.ru
PUBLIC_ADMIN_URL=https://beautyadm.loomixx.ru
PUBLIC_API_URL=https://beauty.loomixx.ru/api/v1
INTERNAL_API_URL=https://beautyadm.loomixx.ru/api/v1
CORS_ADMIN_ORIGINS=https://beautyadm.loomixx.ru
CORS_MINIAPP_ORIGINS=https://beauty.loomixx.ru

# --- Centrifugo (server API on app VM over WireGuard) ---
CENTRIFUGO_API_URL=http://10.8.0.1:8000/api
CENTRIFUGO_API_KEY=
CENTRIFUGO_TOKEN_SECRET=

# --- Ops hooks: the admin API calls these instead of getting shell on other hosts ---
BACKUP_TRIGGER_URL=http://10.8.0.2:9999/backup
BACKUP_TRIGGER_TOKEN=
RESTART_TRIGGER_URL=
RESTART_TRIGGER_TOKEN=
# Metrics are proxied through the staff API; the browser never queries Prometheus
PROMETHEUS_URL=http://prometheus:9090
METRICS_TOKEN=

# --- Admin network exposure ---
# Comma-separated CIDRs allowed to reach beautyadm.loomixx.ru.
# Always include the WireGuard mesh plus office / VPN egress addresses.
ADMIN_ALLOWLIST_SOURCE_RANGE=10.8.0.0/24,127.0.0.1/32

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# --- Observability / TLS ---
SENTRY_DSN_ADMIN_API=
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
ACME_EMAIL=
CF_DNS_API_TOKEN=
