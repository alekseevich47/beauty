# Local development — copy to .env.dev (used by docker-compose.dev.yml)
COMPOSE_PROJECT_NAME=beauty-dev

POSTGRES_DB=beauty
POSTGRES_USER=beauty
POSTGRES_PASSWORD=beauty

CENTRIFUGO_TOKEN_HMAC_SECRET_KEY=dev-token-secret-change-me
CENTRIFUGO_API_KEY=dev-api-key-change-me
CENTRIFUGO_ADMIN_PASSWORD=dev-admin
CENTRIFUGO_ADMIN_SECRET=dev-admin-secret
