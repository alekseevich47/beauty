{
  "token_hmac_secret_key": "${CENTRIFUGO_TOKEN_HMAC_SECRET_KEY}",
  "api_key": "${CENTRIFUGO_API_KEY}",
  "admin": true,
  "admin_password": "${CENTRIFUGO_ADMIN_PASSWORD}",
  "admin_secret": "${CENTRIFUGO_ADMIN_SECRET}",
  "allowed_origins": ["https://beauty.loomixx.ru", "https://beautyadm.loomixx.ru"],
  "client_insecure": false,
  "port": 8000,
  "internal_port": 9000,
  "prometheus": true,
  "health": true,
  "log_level": "info",
  "namespaces": [
    {
      "name": "chat",
      "presence": true,
      "join_leave": true,
      "history_size": 100,
      "history_ttl": "720h",
      "force_recovery": true,
      "allow_subscribe_for_client": false,
      "allow_publish_for_client": false
    },
    {
      "name": "support",
      "presence": true,
      "join_leave": true,
      "history_size": 200,
      "history_ttl": "720h",
      "history_meta_ttl": "2160h",
      "force_recovery": true,
      "allow_subscribe_for_client": false,
      "allow_publish_for_client": false
    },
    {
      "name": "notify",
      "presence": false,
      "history_size": 50,
      "history_ttl": "24h",
      "allow_subscribe_for_client": false,
      "allow_publish_for_client": false
    }
  ]
}
